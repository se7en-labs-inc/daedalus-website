---
layout: layouts/base.njk
pageTitle: Home
permalink: /
---
{% set c = i18n[lang].pages.index %}

<section class="hero-section container">
  <h1>{{ c.title }}</h1>
  <p>{{ c.subtitle }}</p>
  <div class="hero-buttons">
    <a class="btn-primary" href="{{ '/download/' | langUrl(lang) | url }}">{{ c.cta.learn }}</a>
    <a class="btn-secondary" href="{{ c.cta.support_link }}" target="_blank" rel="noopener noreferrer">{{ c.cta.support }}</a>
  </div>
</section>

<section class="container" style="margin-top:6rem;">
  <div class="info-box">
    <h2>{{ c.overview.title }}</h2>
    <p>{{ c.overview.content }}</p>
  </div>
</section>

{% if c.wallet_features %}
<section class="features-section">
  <img class="features-spinner" src="{{ '/images/spinner.svg' | url }}" alt="" aria-hidden="true">
  <div class="container">
    <h2 class="features-title">{{ c.wallet_features.title }}</h2>
    <div class="features-grid-wrap">
      <div class="features-grid">
        <div>
          <div class="feature-item">
            <h4><img src="{{ '/images/daedalus_security.svg' | url }}" alt=""><span>{{ c.wallet_features.advanced_security.title }}</span></h4>
            <p>{{ c.wallet_features.advanced_security.description }}</p>
          </div>
          <div class="feature-item">
            <h4><img src="{{ '/images/daedalus_wallet.svg' | url }}" alt=""><span>{{ c.wallet_features.unlimited_accounting.title }}</span></h4>
            <p>{{ c.wallet_features.unlimited_accounting.description }}</p>
          </div>
          <div class="feature-item">
            <h4><img src="{{ '/images/daedalus_desktop.svg' | url }}" alt=""><span>{{ c.wallet_features.desktop_platforms.title }}</span></h4>
            <p>{{ c.wallet_features.desktop_platforms.description }}</p>
          </div>
        </div>
        <div>
          <div class="feature-item">
            <h4><img src="{{ '/images/daedalus_news.svg' | url }}" alt=""><span>{{ c.wallet_features.newsfeed.title }}</span></h4>
            <p>{{ c.wallet_features.newsfeed.description }}</p>
          </div>
          <div class="feature-item">
            <h4><img src="{{ '/images/daedalus_theme.svg' | url }}" alt=""><span>{{ c.wallet_features.personalization.title }}</span></h4>
            <p>{{ c.wallet_features.personalization.description }}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endif %}
