---
layout: layouts/base.njk
pageTitle: Download
permalink: /download/
---
{% set c = i18n[lang].pages.download %}
<div class="container" style="padding-top:4rem; text-align:center;">
  <h1>{{ c.title }}</h1>
  <p>{{ c.subtitle }}</p>

  <nav class="download-channel-nav" aria-label="{{ c.title }}">
    <a href="#mainnet">{{ c.mainnet.heading }}</a>
    <a href="#pilot">{{ c.pilot.heading }}</a>
  </nav>

  <section id="mainnet" class="download-channel" aria-labelledby="mainnet-heading">
    <h2 id="mainnet-heading">{{ c.mainnet.heading }}</h2>
    <p>{{ c.mainnet.description }}</p>
    {% set channel = "mainnet" %}
    {% set channelContent = c.mainnet %}
    {% set endpoint = site.downloadEndpoint %}
    {% include "partials/download-root.njk" %}

  {% if c.linux_section %}
  <section id="linux-section" class="linux-section" hidden>
    <div class="linux-section-head">
      <img src="{{ '/images/linux.svg' | url }}" alt="Linux" width="40" height="40">
      <h2>{{ c.linux_section.heading }}</h2>
    </div>
    <p class="linux-intro">{{ c.linux_section.intro }}</p>

    <div class="pkg-tabs" role="tablist">
      <button class="pkg-tab active" role="tab" data-target="apt">{{ c.linux_section.tabs.apt }}</button>
      <button class="pkg-tab" role="tab" data-target="yum">{{ c.linux_section.tabs.yum }}</button>
      <button class="pkg-tab" role="tab" data-target="arch">{{ c.linux_section.tabs.arch }}</button>
      <button class="pkg-tab" role="tab" data-target="nixos">{{ c.linux_section.tabs.nixos }}</button>
    </div>

    <div class="pkg-panel" id="panel-apt">
      <pre><code>curl https://daedalus.se7enlabs.org/apt/daedalus-release.gpg | gpg --dearmor \
  | sudo tee /etc/apt/keyrings/daedalus.gpg
echo 'deb [signed-by=/etc/apt/keyrings/daedalus.gpg] https://daedalus.se7enlabs.org/apt stable main' \
  | sudo tee /etc/apt/sources.list.d/daedalus.list
sudo apt update &amp;&amp; sudo apt install daedalus</code></pre>
    </div>

    <div class="pkg-panel" id="panel-yum" hidden>
      <pre><code>sudo rpm --import https://daedalus.se7enlabs.org/yum/daedalus-release.gpg
sudo tee /etc/yum.repos.d/daedalus.repo &lt;&lt;'EOF'
[daedalus]
name=Daedalus
baseurl=https://daedalus.se7enlabs.org/yum
enabled=1
gpgcheck=1
gpgkey=https://daedalus.se7enlabs.org/yum/daedalus-release.gpg
EOF
sudo dnf install daedalus</code></pre>
    </div>

    <div class="pkg-panel" id="panel-arch" hidden>
      <p class="pkg-note">{{ c.linux_section.arch_note }}</p>
      <pre><code>[daedalus]
Server = https://daedalus.se7enlabs.org/arch
SigLevel = Required DatabaseOptional</code></pre>
      <p class="pkg-note">{{ c.linux_section.then_run }}</p>
      <pre><code>sudo pacman -Sy daedalus</code></pre>
    </div>

    <div class="pkg-panel" id="panel-nixos" hidden>
      <p class="pkg-note">{{ c.linux_section.nixos_note }}</p>
      <pre><code>inputs.daedalus.url = "github:input-output-hk/daedalus/<span id="nixos-version-tag">&hellip;</span>";

# NixOS configuration:
services.daedalus = {
  enable = true;
  clusters = [ "mainnet" ];
  packages.mainnet = inputs.daedalus.packages.${pkgs.system}."nixos-package-mainnet";
};</code></pre>
    </div>

    <div id="linux-pkg-links"></div>
  </section>
  {% endif %}

  </section>

  <section id="pilot" class="download-channel" aria-labelledby="pilot-heading">
    <h2 id="pilot-heading">{{ c.pilot.heading }}</h2>
    <p>{{ c.pilot.description }}</p>
    <div class="download-callout">{{ c.pilot.storage }}</div>
    {% set channel = "pilot" %}
    {% set channelContent = c.pilot %}
    {% set endpoint = site.pilotDownloadEndpoint %}
    {% include "partials/download-root.njk" %}
  </section>

  {% include "partials/download-modals.njk" %}

  {% if c.warning %}
    <div class="download-callout">{{ c.warning }}</div>
  {% endif %}

  {% if c.supported_platforms or c.recommended_hardware %}
  <div class="download-specs">
    {% if c.supported_platforms %}
    <section class="download-spec-col">
      <p class="spec-label">{{ c.supported_platforms.heading }}</p>
      <ul>
        {% if c.supported_platforms.mac %}<li><strong>macOS</strong> {{ c.supported_platforms.mac }}</li>{% endif %}
        {% if c.supported_platforms.win %}<li><strong>Windows</strong> {{ c.supported_platforms.win }}</li>{% endif %}
        {% if c.supported_platforms.linux %}<li><strong>Linux</strong> {{ c.supported_platforms.linux.aimed_at }}</li>{% endif %}
      </ul>
    </section>
    {% endif %}
    {% if c.recommended_hardware %}
    <section class="download-spec-col">
      <p class="spec-label">{{ c.recommended_hardware.heading }}</p>
      <ul>
        {% if c.recommended_hardware.item1 %}<li>{{ c.recommended_hardware.item1 }}</li>{% endif %}
        {% if c.recommended_hardware.item2 %}<li>{{ c.recommended_hardware.item2 }}</li>{% endif %}
        {% if c.recommended_hardware.item3 %}<li>{{ c.recommended_hardware.item3 }}</li>{% endif %}
        {% if c.recommended_hardware.item4 %}<li>{{ c.recommended_hardware.item4 }}</li>{% endif %}
      </ul>
    </section>
    {% endif %}
  </div>
  {% endif %}
</div>
<script src="{{ '/assets/js/download.js' | url }}"></script>
