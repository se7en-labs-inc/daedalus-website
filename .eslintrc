{
  "parser": "babel-eslint",
  "parserOptions": {
    "ecmaVersion": 2017
  },
  "plugins": ["react"],
  "extends": ["standard", "standard-react"],
  "rules": {
    "template-curly-spacing": "off",
    "react/jsx-fragments": ["error", "element"],
    "quotes": ["error", "single", { "allowTemplateLiterals": true }],
    "jsx-quotes": ["error", "prefer-double"],
    "comma-dangle": ["error", "only-multiline"],
    "react/jsx-curly-newline": ["off"],
    "react/jsx-tag-spacing": [
      "error",
      {
        "closingSlash": "never",
        "beforeSelfClosing": "always",
        "afterOpening": "never",
        "beforeClosing": "never"
      }
    ],
    "react/jsx-curly-brace-presence": ["error", "never"],
    "react/jsx-closing-bracket-location": ["error", "tag-aligned"],
    "react/prop-types": "off",
    "space-before-function-paren": [
      "error",
      {
        "anonymous": "never",
        "named": "never",
        "asyncArrow": "always"
      }
    ],
    // Leaving off for now as I feel this is best left to developer preference in context
    "curly": "off",
    // Disable indent rules from ESLINT in favour of prettiers more complex and useful indentation
    "indent": "off",
    "jsx-indent": "off",
    "react/jsx-indent": "off"
  },
  "globals": {
    "WebSocket": true,
    "jest": true,
    "describe": true,
    "expect": true,
    "test": true,
    "beforeEach": true,
    "afterEach": true,
    "it": true,
    "requestAnimationFrame": true,
    "cancelAnimationFrame": true,
    "Image": true,
    "fetch": true
  }
}
