<header>
  <!-- header-space: sets 40rem document-flow height; nav + lang switch live here -->
  <div class="header-space">
    <div class="lang-switch">
      {% if lang === 'ja' %}
        {% set enUrl = page.url | replace('/ja/', '/') | replace('/ja', '/') | url %}
        {% set jaUrl = page.url | url %}
      {% else %}
        {% set enUrl = page.url | url %}
        {% set jaUrl = ('/ja' + page.url) | url %}
      {% endif %}
      <select id="lang-select" onchange="window.location.href=this.value" aria-label="Select language">
        <option value="{{ enUrl }}" {% if lang === 'en' %}selected{% endif %}>🇺🇸 English</option>
        <option value="{{ jaUrl }}" {% if lang === 'ja' %}selected{% endif %}>🇯🇵 日本語</option>
      </select>
    </div>
    <nav class="desktop-nav">
      <div class="nav-line nav-line-left"></div>
      <ul>
        <li><a href="{{ '/' | langUrl(lang) | url }}">{{ i18n[lang].global.navigation.labels.home }}</a></li>
        <li><a href="{{ '/team/' | langUrl(lang) | url }}">{{ i18n[lang].global.navigation.labels.team }}</a></li>
        <li><a href="{{ '/download/' | langUrl(lang) | url }}">{{ i18n[lang].global.navigation.labels.download }}</a></li>
        <li><a href="{{ '/reports/' | langUrl(lang) | url }}">{{ i18n[lang].global.navigation.labels.reports }}</a></li>
      </ul>
      <div class="nav-line nav-line-right"></div>
    </nav>
    <button class="burger" id="burger-btn">&#9776;</button>
  </div>

  <!-- mobile-nav: sibling of header-space so it isn't trapped inside its stacking context -->
  <nav class="mobile-nav hidden" id="mobile-nav">
    <ul>
      <li><a href="{{ '/' | langUrl(lang) | url }}">{{ i18n[lang].global.navigation.labels.home }}</a></li>
      <li><a href="{{ '/team/' | langUrl(lang) | url }}">{{ i18n[lang].global.navigation.labels.team }}</a></li>
      <li><a href="{{ '/download/' | langUrl(lang) | url }}">{{ i18n[lang].global.navigation.labels.download }}</a></li>
      <li><a href="{{ '/reports/' | langUrl(lang) | url }}">{{ i18n[lang].global.navigation.labels.reports }}</a></li>
    </ul>
  </nav>

  <!-- header-sub: absolutely positioned; holds Medusa bg + logo (55.8rem visual height) -->
  <div class="header-sub">
    <div class="header-bg">
      <div class="header-gradient-top"></div>
      <div class="medusa-container">
        <img class="medusa-static" src="{{ '/images/static-medusa.jpg' | url }}" alt="" aria-hidden="true">
        <iframe src="{{ site.medusaSrc }}?lang={{ lang }}&repo=daedalus" title="Medusa visualization" loading="lazy"></iframe>
      </div>
      <div class="header-gradient-bot"></div>
    </div>
    <div class="logo-container">
      <a href="{{ '/' | langUrl(lang) | url }}">
        <img src="{{ '/images/daedalus-logo-netlify.svg' | url }}" alt="Daedalus logo">
        <p class="logo-text">Daedalus <strong>Wallet</strong></p>
      </a>
    </div>
    <div class="open-medusa-btn">
      <a href="https://github.com/input-output-hk/daedalus" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="35" height="35" aria-hidden="true">
          <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
        </svg>
      </a>
    </div>
  </div>
</header>
